# Empower Jhang - Production Environment Variables

# Node & Server Setup
NODE_ENV=production
PORT=5000

# Base URL of the Frontend Application (used for CORS and QR code profiles)
APP_URL=https://empowerjhang.org

# Database Configuration (Hostinger MySQL credentials)
# Replace placeholder details with your actual Hostinger MySQL database URL
DATABASE_URL="mysql://hostinger_db_user:secure_password@127.0.0.1:3306/hostinger_db_name"

# Security (Change to a long, cryptographically strong random string)
JWT_SECRET="super-secret-admin-token-key-change-in-production"

# Brevo Transactional Email Gateway Config
BREVO_API_KEY="xkeysib-your-brevo-api-key"
BREVO_FROM_EMAIL="info@empowerjhang.org"

# Disk Storage Paths (Relative or Absolute)
# Default locations are mapped relative to the backend app root directory.
UPLOAD_PATH="../uploads"
LOG_PATH="../logs"
