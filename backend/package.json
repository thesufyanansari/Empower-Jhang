{
  "name": "empower-jhang-server",
  "version": "1.0.0",
  "description": "Empower Jhang Full-Stack Backend",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "nodemon src/index.js",
    "build": "esbuild src/index.js --bundle --platform=node --target=node20 --outfile=dist/server.js --minify --packages=external --format=esm",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma db push"
  },
  "dependencies": {
    "@getbrevo/brevo": "^2.2.0",
    "@prisma/client": "^5.16.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "empower-jhang-workspace": "file:..",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "esbuild": "^0.20.2",
    "nodemon": "^3.1.4",
    "prisma": "^5.16.0"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
